# Pozitívny príklad 1: Základný model BMW X5
# Inicializácia modelu s motorom a jeho výkonom
Ι(x, X5) ∧ 
Ι(e, Engine) ∧ 
Π(x, e) ∧ 
Α(e, power, 250)

# Pozitívny príklad 2: X5 je typom SUV, ktorý je typom Car
# Aktivuje climb-tree heuristiku
Ι(x, X5) ∧
Ι(s, SUV) ∧
Ι(c, Car) ∧
Π(x, s) ∧
Π(s, c) ∧
Ι(e, Engine) ∧ 
Π(x, e) ∧ 
Α(e, power, 250)

# Negatívny príklad 1: X5 bez motora
# Aktivuje require-link heuristiku (toto je zámerný príklad pre odhalenie povinného spojenia)
Ι(x, X5)

# Pozitívny príklad 3: X5 s diesel motorom
# Aktivuje close-interval na hodnotu výkonu
Ι(x, X5) ∧ 
Ι(e, DieselEngine) ∧ 
Π(x, e) ∧ 
Α(e, power, 265)

# Pozitívny príklad 4: X5 s inou konfiguráciou motora
# Aktivuje enlarge-set pre valce
Ι(x, X5) ∧ 
Ι(e, DieselEngine) ∧ 
Π(x, e) ∧ 
Α(e, power, 265) ∧
Α(e, cylinders, 6)

# Pozitívny príklad 5: X5 s benzínovým motorom
# Aktivuje drop-link medzi X5 a DieselEngine, čím sa vytvára všeobecnejší vzťah
Ι(x, X5) ∧ 
Ι(e, PetrolEngine) ∧ 
Π(x, e) ∧ 
Α(e, power, 300)

# Pozitívny príklad 6: X5 s rozšírenými dátami motora
# Aktivuje close-interval pre torque
Ι(x, X5) ∧ 
Ι(e, Engine) ∧ 
Π(x, e) ∧ 
Α(e, power, 300) ∧
Α(e, torque, 450)

# Negatívny príklad 2: X5 s manuálnou prevodovkou
# Aktivuje forbid-link medzi X5 a ManualTransmission
Ι(x, X5) ∧ 
Ι(e, Engine) ∧ 
Ι(t, ManualTransmission) ∧ 
Π(x, e) ∧ 
Π(x, t) ∧ 
Α(e, power, 265)

# Pozitívny príklad 7: X5 s automatickou prevodovkou
# Aktivuje add-missing-object pre typ prevodovky
Ι(x, X5) ∧ 
Ι(e, Engine) ∧ 
Ι(t, AutomaticTransmission) ∧ 
Π(x, e) ∧ 
Π(x, t) ∧ 
Α(e, power, 265) ∧
Α(t, gears, 8)

